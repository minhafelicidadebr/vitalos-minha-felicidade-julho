{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vitalos.com.br/schemas/learning-dynamics-registry.schema.json",
  "title": "Learning Dynamics Registry VitalOS — Onda LDX-1",
  "description": "Registro canônico de governança das 14 dinâmicas de aprendizagem (LD-001..LD-014). Regra de ouro: nenhuma interface pode apresentar uma dinâmica com status superior ao autorizado aqui. Distinto do catálogo pedagógico D1..X3 de src/engine/learning/learning-dynamics.ts (dinâmicas WWP de /academia) — este registro governa maturidade/exposição, aquele governa pedagogia por eixo M.E.T.E.",
  "type": "object",
  "required": ["registry", "version", "frozen", "dynamics"],
  "properties": {
    "registry": { "const": "Learning Dynamics Registry VitalOS" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "frozen": { "type": "boolean" },
    "sourceDocument": { "type": "string" },
    "dynamics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "slug",
          "title",
          "shortLabel",
          "description",
          "kind",
          "meteAxes",
          "primaryOutcome",
          "authorizedRoles",
          "enrichesRoutes",
          "runtimeStatus",
          "contentStatus",
          "persistenceStatus",
          "aiMode",
          "publicExposure",
          "riskTier",
          "dataClasses",
          "evidenceRefs",
          "runtimeEvidence",
          "documentationEvidence",
          "dependencies",
          "forbiddenUses",
          "accessibilityRequirements",
          "acceptanceCriteria",
          "rolloutWave"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^LD-\\d{3}$" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 3 },
          "shortLabel": { "type": "string", "minLength": 2, "maxLength": 40 },
          "description": { "type": "string", "minLength": 10 },
          "kind": { "type": "string" },
          "meteAxes": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["medir", "educar", "transformar", "evoluir"] }
          },
          "primaryOutcome": { "type": "string", "minLength": 5 },
          "authorizedRoles": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Vazio é válido para PLANNED/PROPOSED/R_AND_D sem papel ainda mapeado."
          },
          "enrichesRoutes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Vazio é válido para PROPOSED/R_AND_D sem superfície ainda mapeada."
          },
          "runtimeStatus": {
            "enum": ["REAL", "PARCIAL", "DEMO", "PLANNED", "PROPOSED", "R_AND_D", "AUSENTE", "DEPRECATED"]
          },
          "contentStatus": { "enum": ["VERIFIED", "CURATED", "DEMO", "DRAFT", "ABSENT"] },
          "persistenceStatus": {
            "enum": [
              "PERSISTED_PRIVATE",
              "PERSISTED_TENANT",
              "PERSISTED_AGGREGATED",
              "SESSION_ONLY",
              "NONE",
              "NOT_APPLICABLE"
            ]
          },
          "aiMode": { "enum": ["NONE", "DETERMINISTIC", "GENERATIVE_GATED", "GENERATIVE_PROHIBITED"] },
          "publicExposure": { "enum": ["AVAILABLE", "PILOT", "DEMO", "PREPARATION", "HIDDEN", "R_AND_D"] },
          "riskTier": { "enum": ["R1_LOW", "R2_MODERATE", "R3_HIGH", "R4_CRITICAL"] },
          "dataClasses": { "type": "array", "items": { "type": "string" } },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } },
          "runtimeEvidence": { "type": "array", "items": { "type": "string" } },
          "documentationEvidence": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "forbiddenUses": { "type": "array", "items": { "type": "string" } },
          "accessibilityRequirements": { "type": "array", "items": { "type": "string" } },
          "acceptanceCriteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "rolloutWave": { "type": "string", "minLength": 2 }
        },
        "allOf": [
          {
            "description": "PLANNED/PROPOSED/R_AND_D/AUSENTE/DEPRECATED nunca têm exposição operacional — fecha a invariante 'sem funcionalidade fantasma' por construção no schema.",
            "if": {
              "properties": {
                "runtimeStatus": { "enum": ["PLANNED", "PROPOSED", "R_AND_D", "AUSENTE", "DEPRECATED"] }
              }
            },
            "then": {
              "properties": {
                "publicExposure": { "enum": ["PREPARATION", "HIDDEN", "R_AND_D"] }
              }
            }
          },
          {
            "description": "GENERATIVE_GATED não é autorizado nesta onda (LDX-1 não integra LLM/RAG).",
            "if": { "properties": { "aiMode": { "const": "GENERATIVE_GATED" } } },
            "then": { "properties": { "dependencies": { "type": "array", "minItems": 1 } } }
          }
        ]
      }
    }
  }
}
