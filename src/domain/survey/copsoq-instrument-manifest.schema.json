{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "copsoq-instrument-manifest.schema.json",
  "title": "COPSOQ Instrument Manifest",
  "description": "Contrato canônico do instrumento Domínio B. Readonly, versionado, fail-closed: o validador recusa manifesto sem fonte, sem licença declarada, com contagens incoerentes ou com hash malformado. A regra semântica central (demonstrativo nunca autoriza linguagem de validado) é imposta pelo teste copsoq-instrument-manifest.test.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "manifest",
    "description",
    "frozen",
    "instrument_id",
    "official_name",
    "served_name",
    "version",
    "locale",
    "form",
    "adaptation",
    "sources",
    "licence",
    "attribution",
    "validation_status",
    "norm_reference",
    "scoring",
    "hash_algorithm",
    "outcome_dimension_ids",
    "item_count",
    "dimension_count",
    "exposure_dimension_count",
    "outcome_dimension_count",
    "dimensions",
    "reversed_items",
    "item_hashes",
    "allowed_claims",
    "forbidden_claims"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "manifest": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "frozen": { "const": true },
    "instrument_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "official_name": { "type": "string", "minLength": 1 },
    "served_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "form": { "type": "string", "minLength": 1 },
    "adaptation": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["citation"],
        "properties": {
          "citation": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note"],
      "properties": {
        "status": {
          "enum": ["sem_licenca_de_versao_validada", "licenca_validada_registrada"]
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "attribution": { "type": "string", "minLength": 1 },
    "validation_status": {
      "enum": ["validado", "validado_adaptado", "exploratorio", "demonstrativo"]
    },
    "norm_reference": {
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scale_min",
        "scale_max",
        "scale_kind",
        "scale_labels",
        "reversed_meaning",
        "aggregation"
      ],
      "properties": {
        "scale_min": { "type": "integer" },
        "scale_max": { "type": "integer" },
        "scale_kind": { "type": "string", "minLength": 1 },
        "scale_labels": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "reversed_meaning": { "type": "string", "minLength": 1 },
        "aggregation": { "type": "string", "minLength": 1 }
      }
    },
    "hash_algorithm": { "type": "string", "minLength": 1 },
    "outcome_dimension_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "item_count": { "type": "integer", "minimum": 1 },
    "dimension_count": { "type": "integer", "minimum": 1 },
    "exposure_dimension_count": { "type": "integer", "minimum": 1 },
    "outcome_dimension_count": { "type": "integer", "minimum": 0 },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "item_ids"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["exposure", "outcome"] },
          "item_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "reversed_items": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "item_hashes": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "allowed_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
