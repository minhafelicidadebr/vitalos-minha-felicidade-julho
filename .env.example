# ═══════════════════════════════════════════════════════════════════════════
# .env.example — modelo das variáveis de ambiente (SEM valores reais).
# Copie para .env e preencha. O .env real é ignorado pelo git (P1-01).
#
# As chaves SUPABASE_* aqui são PUBLISHABLE/ANON (seguras para o cliente).
# A service role key NUNCA vai para .env nem para o repo — só na secret de
# servidor do Lovable Cloud.
# ═══════════════════════════════════════════════════════════════════════════

# Projeto Supabase (Lovable Cloud)
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""

# Espelhos VITE_* — injetados no bundle do cliente em build time.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# E-mails com permissão de admin da PLATAFORMA (geram convites em /plataforma).
# Múltiplos separados por vírgula.
# ATENÇÃO — duas fontes de verdade: LOCAL lê daqui; PRODUÇÃO usa a secret de
# servidor do Lovable Cloud (não lê este arquivo em runtime). Mantenha iguais.
PLATFORM_ADMIN_EMAILS=""

# Endereço público real do app — monta os links de convite (org e pesquisa).
VITE_APP_URL=""
