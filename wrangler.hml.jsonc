// Configuração explícita do Worker de homologação sintética FIB-T (ISG),
// separada do wrangler.json que o preset nitro "cloudflare-module" gera
// automaticamente dentro de .output/server/ a cada build.
//
// Por que este arquivo existe: o auto-gerado usa um nome derivado do
// diretório do worktree/pasta local (ex.: "tanstack-start-ts-<pasta>"), o
// que muda a cada worktree e nunca é "vitalos-fibt-hml-isg". Este arquivo
// fixa a identidade do Worker; os caminhos de main/assets abaixo apontam
// para o artefato de build (.output/), relativos à raiz do repositório
// (onde este arquivo vive), não relativos a .output/server/ como no gerado.
//
// Uso pretendido (NÃO executado por esta preparação):
//   bunx wrangler deploy --config wrangler.hml.jsonc
//
// Este arquivo NUNCA deve conter: SUPABASE_URL, chaves, project ref (staging
// ou produção), account_id ou zone_id reais. Todas essas variáveis são
// configuradas no ambiente do Worker (Cloudflare dashboard/CLI secrets),
// nunca aqui — ver docs/fibt-hml/CLOUDFLARE_HML_DEPLOYMENT.md.
{
  "name": "vitalos-fibt-hml-isg",

  // Pinado explicitamente (não deixado para o nitro auto-derivar por build) —
  // mudar esta data é uma decisão deliberada, não um efeito colateral do build.
  "compatibility_date": "2026-08-01",

  // Necessário: process.env.* é lido em tempo de execução por
  // hml-backend-boundary.server.ts, client.server.ts e identity-boundary
  // .server.ts (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, FIBT_HML_*,
  // VITALOS_PRODUCTION_PROJECT_REF) — sem nodejs_compat, o runtime Workers
  // não expõe process.env do jeito que este código espera. O próprio preset
  // nitro já inclui esta flag automaticamente no wrangler.json auto-gerado
  // (confirmado por build local sintético) — declarada aqui explicitamente
  // pelo mesmo motivo técnico, não por precaução vaga.
  "compatibility_flags": ["nodejs_compat"],

  // Subdomínio workers.dev, nunca um domínio próprio nesta fase — a
  // autorização proíbe registrar rota para vitalos.com.br ou qualquer
  // domínio produtivo, e nenhuma rota é declarada abaixo.
  "workers_dev": true,

  // FIBT-HML-3A: Preview URLs desabilitadas. Cada `wrangler versions upload`
  // geraria, por padrão, uma URL de preview própria e imprevisível
  // (ex.: <hash>-vitalos-fibt-hml-isg.<subdomínio>.workers.dev) — uma
  // superfície de acesso adicional, sem Cloudflare Access configurado nela
  // por padrão, fora do controle documentado nesta preparação. Só a URL
  // principal `*.workers.dev` (a mesma que recebe Cloudflare Access, ver
  // CLOUDFLARE_HML_DEPLOYMENT.md) deve existir. Reabilitar Preview URLs
  // exige autorização própria E Cloudflare Access cobrindo também o
  // subdomínio de preview — confirmado como campo reconhecido pelo parser
  // do Wrangler (testado: um campo genuinamente desconhecido gera
  // "Unexpected fields found in top-level field", este não gera nenhum aviso).
  "preview_urls": false,

  // Caminhos relativos à raiz do repo (onde este arquivo vive) — apontam
  // para o artefato já produzido por `bun run build:hml:staging`.
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    // FIBT-HML-2C (Fase 6): o artefato atual não tem nenhum HTML estático
    // que pudesse sombrear uma rota de página (.output/public/ só contém
    // /assets/*.js|css e favicon.ico — confirmado por build sintético) — ou
    // seja, hoje toda navegação de página já cai no Worker por padrão, sem
    // precisar disso. Ligado mesmo assim como defesa em profundidade: se
    // algum dia um HTML estático (ex.: página de manutenção, 404 customizado)
    // for adicionado a .output/public/, run_worker_first garante que o
    // Worker (e o boundary de rotas, hml-deployment-boundary.server.ts)
    // continua sendo a primeira parada — nunca um fallback estático servido
    // direto pela borda da Cloudflare. Custo (toda requisição de asset passa
    // pelo Worker) é aceitável numa instância de homologação de baixo tráfego.
    "run_worker_first": true
  },

  // O artefato do nitro já vem totalmente empacotado — instrui o Wrangler a
  // não tentar rebundlar (mesmo valor do wrangler.json auto-gerado).
  "no_bundle": true,

  // FIBT-HML-4D — OBRIGATÓRIO com no_bundle. Copiado literalmente do
  // wrangler.json que o nitro gera em .output/server/ a cada build (1 regra,
  // type "ESModule", estes dois globs, sem fallthrough).
  //
  // Por que existe: `no_bundle` e `rules` resolvem problemas DIFERENTES, e
  // confundi-los custou uma tentativa de deploy inteira.
  //   - `no_bundle` decide se o Wrangler reprocessa/empacota o entrypoint;
  //   - `rules` decide como os DEMAIS arquivos do diretório são CLASSIFICADOS
  //     (aqui: como módulos ES) para virarem módulos disponíveis ao runtime.
  // Desligar o bundling não dispensa a classificação — pelo contrário: com
  // no_bundle, ela é a única coisa que registra os ~375 arquivos .mjs
  // adicionais como módulos carregáveis.
  //
  // Sem este bloco, o upload sobe os arquivos fisicamente e os imports são
  // corretos, mas o workerd recusa em runtime com `No such module "..."`.
  // Reproduzido localmente com `wrangler dev --local` (sem rede) e corrigido
  // por adicionar EXCLUSIVAMENTE este bloco — nenhuma renomeação de chunk foi
  // necessária, inclusive nos nomes que contêm "+" (a hipótese inicial de que
  // o "+" era a causa foi testada e refutada).
  //
  // find_additional_modules e base_dir NÃO são declarados aqui de propósito:
  // o nitro também não os declara, e o comportamento padrão do Wrangler já
  // encontra os módulos corretamente (confirmado: 374 módulos carregados).
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"],
    },
  ],
}
