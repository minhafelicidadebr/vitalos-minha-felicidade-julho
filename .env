# identity-boundary.server.ts. Sem elas o SSR nao resolve sessao.
SUPABASE_URL=https://shlmzzchddohaytfakol.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNobG16emNoZGRvaGF5dGZha29sIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM5NDU1MzgsImV4cCI6MjA5OTUyMTUzOH0.UT6xqhXc_mBejQArSDke6qdfmCkaflOoYUyCHlK5K2M

# --- Lado navegador (embutidas no bundle em build time) --------------------
VITE_SUPABASE_URL=https://shlmzzchddohaytfakol.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNobG16emNoZGRvaGF5dGZha29sIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM5NDU1MzgsImV4cCI6MjA5OTUyMTUzOH0.UT6xqhXc_mBejQArSDke6qdfmCkaflOoYUyCHlK5K2M

