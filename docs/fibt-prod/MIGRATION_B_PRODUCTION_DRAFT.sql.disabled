-- ===========================================================================
-- 2. PRECONDITION -- PRIVACY HARDENING H
-- ===========================================================================
-- Presenca nominal NAO basta: o que importa e o CONTRATO DE RETORNO.
-- Nenhuma confianca exclusiva na ACL -- o gate de papel vive no CORPO.
--
-- ---------------------------------------------------------------------------
-- CORRECAO P1-1 (revisao 4) -- por que a versao anterior era insuficiente
-- ---------------------------------------------------------------------------
-- A versao anterior fazia array_to_string(proargnames) e oito predicados LIKE.
-- Isso conferia NOMES e mais nada:
--   * ORDEM trocada passava (a concatenacao contem as mesmas substrings);
--   * TIPO trocado passava (proargnames nao carrega tipo nenhum);
--   * NOME divergente passava se contivesse o esperado como substring --
--     'response_count_label_v2' satisfaz '%response_count_label%'.
-- Agora a verificacao e ESTRUTURAL e POSICIONAL, por dois angulos
-- independentes sobre o mesmo contrato.
--
-- CONTRATO CANONICO -- fonte normativa (NAO copiado de execucao):
--   supabase/migrations/20260730155000_cohort_aggregate_privacy_hardening.sql
--   RETURNS TABLE(...), nesta ordem exata:
--
--     #  nome                    tipo
--     1  visible                 boolean
--     2  response_count          integer
--     3  response_count_label    text
--     4  k_min                   integer
--     5  item_means              jsonb
--     6  factor_scores           jsonb
--     7  domain_means            jsonb
--     8  suppression_reason      text
--
-- ---------------------------------------------------------------------------
-- LIMITE DECLARADO DESTA VERIFICACAO (P2-4) -- ler antes de confiar nela
-- ---------------------------------------------------------------------------
-- A revisao estatica COMPROVA: assinatura de entrada, contrato de retorno
-- (nome + tipo + ordem), SECURITY DEFINER, search_path fixo e gate interno de
-- papel/identidade no corpo.
--
-- A revisao estatica NAO COMPROVA, sem execucao:
--   (a) visible = false abaixo de k;
--   (b) response_count = NULL abaixo de k;
--   (c) response_count_label = '<5' abaixo de k;
--   (d) supressao efetiva de item_means, factor_scores e domain_means;
--   (e) suppression_reason correto.
-- Os cinco sao COMPORTAMENTO, nao estrutura -- nenhum predicado de catalogo os
-- alcanca. Sao item OBRIGATORIO da futura prova em PostgreSQL 17 NAO produtivo
-- (SPEC secao D). NAO executar essa prova agora.

-- DO $$
-- DECLARE
--   v_agg_oid  OID;
--   v_out      TEXT;
--   v_result   TEXT;
--   v_def      TEXT;
--   c_contrato CONSTANT TEXT :=
--     'visible boolean, response_count integer, response_count_label text, '
--     'k_min integer, item_means jsonb, factor_scores jsonb, '
--     'domain_means jsonb, suppression_reason text';
-- BEGIN
--   -- --- H/1 resolucao pela assinatura EXATA DE ENTRADA -----------------------
--   -- to_regprocedure resolve tipos de entrada canonicamente. Nao ha comparacao
--   -- textual de pg_get_function_identity_arguments em lugar nenhum.
--   v_agg_oid := to_regprocedure('public.aggregate_cohort_responses(uuid,uuid)');
--   IF v_agg_oid IS NULL THEN
--     RAISE EXCEPTION 'ABORTADO (H/1): aggregate_cohort_responses(uuid,uuid) ausente.';
--   END IF;
--
--   -- --- H/2 contrato de retorno -- ESTRUTURAL, a partir de pg_proc -----------
--   -- Reconstroi a lista de colunas de SAIDA na ORDEM do catalogo, com o tipo
--   -- resolvido por format_type. proallargtypes/proargmodes sao NULL quando a
--   -- funcao nao declara OUT/TABLE: nesse caso v_out resulta NULL e o
--   -- IS DISTINCT FROM ABORTA -- fail-closed, nunca passa por omissao.
--   SELECT string_agg(t.argname || ' ' || format_type(t.argtype, NULL), ', ' ORDER BY t.ord)
--     INTO v_out
--     FROM pg_proc p
--     CROSS JOIN LATERAL unnest(
--            coalesce(p.proallargtypes, ARRAY[]::OID[]),
--            coalesce(p.proargmodes,    ARRAY[]::"char"[]),
--            coalesce(p.proargnames,    ARRAY[]::TEXT[])
--          ) WITH ORDINALITY AS t(argtype, argmode, argname, ord)
--    WHERE p.oid = v_agg_oid
--      AND t.argmode IN ('t', 'o');   -- 't' = coluna de TABLE, 'o' = OUT
--
--   IF v_out IS DISTINCT FROM c_contrato THEN
--     RAISE EXCEPTION
--       'ABORTADO (H/2): contrato de retorno de aggregate_cohort_responses divergente. '
--       'Esperado [%] -- encontrado [%].',
--       c_contrato, coalesce(v_out, '(sem coluna de saida)');
--   END IF;
--
--   -- --- H/3 representacao canonica do proprio PostgreSQL ---------------------
--   -- pg_get_function_result devolve a forma canonica do RETURNS. E o SEGUNDO
--   -- angulo sobre o MESMO contrato: se H/2 e H/3 discordarem, a leitura do
--   -- catalogo esta errada e a migration nao prossegue.
--   --
--   -- A forma esperada e DERIVADA da definicao canonica de H, nao copiada de
--   -- uma execucao. Como a renderizacao literal e do servidor, a comparacao e
--   -- feita sobre a forma NORMALIZADA (minusculas, espacos colapsados). A
--   -- string exata devolvida pelo PostgreSQL 17 deve ser OBSERVADA, CONFERIDA
--   -- contra este contrato e registrada na prova nao produtiva ANTES da
--   -- promocao (SPEC secao K) -- ate la ela e expectativa, nao fato medido.
--   v_result := pg_get_function_result(v_agg_oid);
--
--   IF lower(regexp_replace(coalesce(v_result, ''), '\s+', ' ', 'g'))
--      IS DISTINCT FROM 'table(' || c_contrato || ')' THEN
--     RAISE EXCEPTION
--       'ABORTADO (H/3): pg_get_function_result divergente do contrato canonico. '
--       'Esperado [table(%)] -- encontrado [%].',
--       c_contrato, coalesce(v_result, '(null)');
--   END IF;
--
--   RAISE NOTICE 'H/2+H/3: contrato de 8 colunas conferido em nome, TIPO e ORDEM. Retorno observado: %', v_result;
--
--   -- --- H/4 SECURITY DEFINER + search_path fixo ------------------------------
--   IF NOT EXISTS (
--     SELECT 1 FROM pg_proc p
--      WHERE p.oid = v_agg_oid
--        AND p.prosecdef IS TRUE
--        AND array_to_string(p.proconfig, ',') LIKE '%search_path=public%'
--   ) THEN
--     RAISE EXCEPTION 'ABORTADO (H/4): aggregate_cohort_responses sem SECURITY DEFINER ou sem search_path fixo.';
--   END IF;
--
--   -- --- H/5 count_cohort_participation ---------------------------------------
--   IF to_regprocedure('public.count_cohort_participation(uuid,uuid)') IS NULL THEN
--     RAISE EXCEPTION 'ABORTADO (H/5): count_cohort_participation(uuid,uuid) ausente.';
--   END IF;
--
--   -- Retorno escalar INTEGER -- contrato proprio, tambem verificado.
--   IF lower(regexp_replace(
--         coalesce(pg_get_function_result(to_regprocedure('public.count_cohort_participation(uuid,uuid)')), ''),
--         '\s+', ' ', 'g')) IS DISTINCT FROM 'integer' THEN
--     RAISE EXCEPTION 'ABORTADO (H/5b): count_cohort_participation nao retorna integer.';
--   END IF;
--
--   IF NOT EXISTS (
--     SELECT 1 FROM pg_proc p
--      WHERE p.oid = to_regprocedure('public.count_cohort_participation(uuid,uuid)')
--        AND p.prosecdef IS TRUE
--        AND array_to_string(p.proconfig, ',') LIKE '%search_path=public%'
--   ) THEN
--     RAISE EXCEPTION 'ABORTADO (H/6): count_cohort_participation sem SECURITY DEFINER ou sem search_path fixo.';
--   END IF;
--
--   -- --- H/7 gate INTERNO de papel/identidade no CORPO ------------------------
--   -- Nao confiar so na ACL: a restricao a RH_ADMIN/DIRETOR e a auth.uid()
--   -- precisa estar no codigo da funcao. ACL permissiva nao pode ser a unica
--   -- barreira.
--   SELECT pg_get_functiondef(to_regprocedure('public.count_cohort_participation(uuid,uuid)'))
--     INTO v_def;
--
--   IF v_def IS NULL
--      OR v_def NOT LIKE '%auth.uid()%'
--      OR v_def NOT LIKE '%RH_ADMIN%'
--      OR v_def NOT LIKE '%DIRETOR%' THEN
--     RAISE EXCEPTION 'ABORTADO (H/7): count_cohort_participation sem gate interno de papel/identidade no corpo.';
--   END IF;
--
--   RAISE NOTICE 'Hardening H: contrato estrutural de 8 colunas, SECURITY DEFINER, search_path e gate interno verificados.';
--   RAISE NOTICE 'H: comportamento abaixo de k (visible/response_count/label/supressao/reason) NAO e verificavel aqui -- prova em PG17 nao produtivo.';
-- END $$;


-- ===========================================================================
-- 3. PRECONDITIONS -- COLUNA, FK EXATA, POLICIES, DEPENDENCIAS E CONTAGENS
-- ===========================================================================
-- Ordem interna (revisao 4):
--   3.1 coluna legada presente
--   3.2 FK exata
--   3.3 INVENTARIO DE POLICIES        <- novo (P2-1)
--   3.4 dependencias catalogais       <- reescrito (P1-2)
--   3.4b triggers                     <- reescrito (P1-3)
--   3.5 AS OITO CONTAGENS, EM UM UNICO SELECT   <- consolidado (P2-2)
--   3.6 invariantes cruzadas
--   3.7 gate de drift operacional
--   3.8 gate de perda de vinculo legado
--   3.9 integridade do conjunto afetado
--   3.10 assinaturas das funcoes de submissao

-- DO $$
-- DECLARE
--   EXPECTED_TOTAL_RESPONSES   CONSTANT INTEGER := 0;  -- gate de drift operacional
--   EXPECTED_WITH_INVITE_TOKEN CONSTANT INTEGER := 0;  -- gate de perda de vinculo
--   EXPECTED_WAVE_RESPONSES_POLICY_COUNT CONSTANT INTEGER := 0;  -- gate de policy
--
--   v_total_responses     INTEGER;
--   v_with_invite_token   INTEGER;
--   v_valid_invite_links  INTEGER;
--   v_orphan_invite_links INTEGER;
--   v_snapshot_rows       INTEGER;
--
--   v_duplicados   INTEGER;
--   v_divergentes  INTEGER;
--   v_org_invalida INTEGER;
--   v_wave_responses_policy_count INTEGER;   -- gate numerico (0.5J)
--   v_policies     TEXT;                     -- metadados seguros, so para o erro
--   v_deps         TEXT;
--   v_trigs        TEXT;
-- BEGIN
--   -- --- 3.1 Coluna legada presente -------------------------------------------
--   IF NOT EXISTS (SELECT 1 FROM information_schema.columns
--                   WHERE table_schema='public' AND table_name='wave_responses'
--                     AND column_name='invite_token') THEN
--     RAISE EXCEPTION 'ABORTADO: invite_token ja ausente -- B possivelmente ja aplicada. Investigar.';
--   END IF;
--
--   -- --- 3.2 FK EXATA ---------------------------------------------------------
--   -- Nao basta "existe alguma FK entre as duas tabelas": o DROP nomeia uma
--   -- constraint especifica. Se o nome divergir, DROP sem IF EXISTS falha
--   -- explicitamente (ver secao 4) -- mas o diagnostico bom vem daqui.
--   IF NOT EXISTS (
--     SELECT 1
--       FROM pg_constraint c
--       JOIN pg_class      t  ON t.oid  = c.conrelid
--       JOIN pg_namespace  n  ON n.oid  = t.relnamespace
--       JOIN pg_class      rt ON rt.oid = c.confrelid
--       JOIN pg_namespace  rn ON rn.oid = rt.relnamespace
--       JOIN pg_attribute  a  ON a.attrelid  = c.conrelid  AND a.attnum  = c.conkey[1]
--       JOIN pg_attribute  ra ON ra.attrelid = c.confrelid AND ra.attnum = c.confkey[1]
--      WHERE n.nspname  = 'public'
--        AND t.relname  = 'wave_responses'
--        AND c.conname  = 'wave_responses_invite_token_fkey'
--        AND c.contype  = 'f'
--        AND a.attname  = 'invite_token'
--        AND rn.nspname = 'public'
--        AND rt.relname = 'wave_invites'
--        AND ra.attname = 'token'
--        AND array_length(c.conkey, 1) = 1
--   ) THEN
--     RAISE EXCEPTION
--       'ABORTADO: FK exata ausente. Esperado public.wave_responses.invite_token '
--       '-> public.wave_invites.token com nome wave_responses_invite_token_fkey.';
--   END IF;
--
--   -- --- 3.3 INVENTARIO DE POLICIES -- BASELINE ZERO (P2-1 / decisao 0.5H) ----
--   -- ESTADO AUTORIZADO em public.wave_responses:
--   --   EXPECTED_WAVE_RESPONSES_POLICY_COUNT = 0. So isso.
--   --
--   -- Fonte: inventario produtivo Q18 -- RLS ATIVO e ZERO policies. RLS ativo
--   -- sem policy e default-deny total; nao ha nada a remover.
--   --
--   -- QUALQUER policy aborta -- INCLUSIVE response_submit. Nao ha policy
--   -- tolerada por nome. Motivo (decisao humana PROD-0.5H): este draft e
--   -- especifico do baseline produtivo ATUAL. A Migration B canonica de staging
--   -- removia response_submit porque cobria um estado historico diferente; aqui
--   -- o reaparecimento da policy nao e "o estado antigo de volta", e DRIFT --
--   -- alguem ou algo recriou uma policy depois do inventario. Uma policy de
--   -- MESMO NOME nao e presumida equivalente a historica: nome nao prova
--   -- expressao, comando, papeis nem intencao.
--   --
--   -- Aborta para: response_submit, qualquer outro nome, permissiva,
--   -- restritiva, e qualquer comando (SELECT, INSERT, UPDATE, DELETE, ALL).
--   --
--   -- O GATE E NUMERICO (0.5J), nao teste de string:
--   --   v_wave_responses_policy_count <> EXPECTED_WAVE_RESPONSES_POLICY_COUNT
--   -- A variavel textual v_policies existe SO para compor a mensagem de erro
--   -- com metadados seguros. Ela nunca decide nada.
--   --
--   -- Metadados registrados -- e SO estes: schema, tabela, nome, comando,
--   -- permissiva/restritiva, papeis. Nenhuma expressao (polqual/polwithcheck) e
--   -- CONSULTADA ou impressa: expressao de policy pode conter literal de negocio.
--   SELECT
--     COUNT(*)::INTEGER,
--     string_agg(
--       format('%I.%I -> policy %I (cmd=%s permissive=%s roles=%s)',
--              pn.nspname, pt.relname, pol.polname, pol.polcmd, pol.polpermissive,
--              coalesce((SELECT string_agg(CASE WHEN r = 0 THEN 'PUBLIC'
--                                              ELSE pg_get_userbyid(r) END, '+' ORDER BY r)
--                          FROM unnest(pol.polroles) r), '(nenhum)')),
--       ', ' ORDER BY pol.polname)
--   INTO v_wave_responses_policy_count, v_policies
--     FROM pg_policy    pol
--     JOIN pg_class     pt ON pt.oid = pol.polrelid
--     JOIN pg_namespace pn ON pn.oid = pt.relnamespace
--    WHERE pn.nspname = 'public'
--      AND pt.relname = 'wave_responses';
--
--   IF v_wave_responses_policy_count <> EXPECTED_WAVE_RESPONSES_POLICY_COUNT THEN
--     RAISE EXCEPTION
--       'ABORTADO (inventario de policies): esperadas % policies em '
--       'public.wave_responses, encontradas % -- %. Isto e DRIFT em relacao ao '
--       'inventario Q18. Listado apenas metadado. NAO remover nenhuma policy '
--       'automaticamente. Exige NOVO inventario, rederivacao deste draft e NOVA '
--       'autorizacao humana.',
--       EXPECTED_WAVE_RESPONSES_POLICY_COUNT, v_wave_responses_policy_count,
--       coalesce(v_policies, '(sem metadado)');
--   END IF;
--
--   RAISE NOTICE 'Inventario de policies em public.wave_responses confirmado: % policies.',
--     v_wave_responses_policy_count;
--
--   -- --- 3.4 DEPENDENCIAS CATALOGAIS SOBRE A COLUNA (P1-2) --------------------
--   -- CORRECAO (revisao 4). A versao anterior fazia
--   --     JOIN pg_class cl ON cl.oid = d.objid
--   -- sem filtrar d.classid, e sem filtrar d.refclassid do lado referenciado.
--   -- Em pg_depend, objid SO e interpretavel junto com classid: OIDs sao unicos
--   -- DENTRO de cada catalogo, nunca globalmente. Consequencias do defeito:
--   --
--   --   * FALSO NEGATIVO -- view e matview dependem de coluna via pg_rewrite
--   --     (classid = pg_rewrite, objid = OID da REGRA, nao da relacao). O join
--   --     com pg_class nunca casava: NENHUMA view dependente era detectada.
--   --     Idem CHECK (pg_constraint), default (pg_attrdef) e funcao (pg_proc).
--   --   * FALSO POSITIVO CRUZADO -- um OID de pg_rewrite pode coincidir com o
--   --     OID de um pg_class sem relacao alguma, inventando um "dependente".
--   --
--   -- Agora: a CTE `alvo` resolve table_oid e attnum REAIS; a CTE `dep` filtra a
--   -- identidade COMPLETA do objeto referenciado (refclassid + refobjid +
--   -- refobjsubid); e cada ramo junta objid EXCLUSIVAMENTE ao catalogo do seu
--   -- proprio classid. classid nao tratado = DEPENDENCIA DESCONHECIDA = aborta.
--   --
--   -- UMA UNICA dependencia e deliberadamente ESPERADA (decisao 0.5H):
--   --
--   --   a FK legada wave_responses_invite_token_fkey, aceita SOMENTE com
--   --   identidade integral: nome + contype='f' + tabela local + coluna local
--   --   + tabela referenciada + coluna referenciada. Uma FK de MESMO NOME
--   --   apontando para outro lugar BLOQUEIA.
--   --
--   -- POLICY NAO E EXCECAO. Nenhuma policy e excluida por nome -- nem
--   -- response_submit. Toda dependencia com classid = pg_policy e BLOQUEADORA.
--   -- Coerente com 3.3: o baseline autorizado e ZERO policies, entao este ramo
--   -- so pode acionar em cenario de drift, e drift tem que parar a migration.
--   --
--   -- Nenhuma outra e excluida, por nome parcial ou por tipo amplo. Dependencia
--   -- interna do catalogo NAO e filtrada por deptype: e classificada e exibida.
--   -- DROP COLUMN sem CASCADE ja falharia -- isso tambem e fail-closed --, mas
--   -- uma precondition explicita produz DIAGNOSTICO, nao um erro obscuro.
--   -- NAO usar CASCADE. NAO remover nada automaticamente.
--   WITH alvo AS (
--     SELECT c.oid AS table_oid, a.attnum AS col_attnum
--       FROM pg_class      c
--       JOIN pg_namespace  n ON n.oid = c.relnamespace
--       JOIN pg_attribute  a ON a.attrelid = c.oid
--      WHERE n.nspname = 'public' AND c.relname = 'wave_responses'
--        AND a.attname = 'invite_token' AND NOT a.attisdropped
--   ),
--   ref_invites AS (
--     SELECT c.oid AS table_oid,
--            (SELECT a.attnum FROM pg_attribute a
--              WHERE a.attrelid = c.oid AND a.attname = 'token' AND NOT a.attisdropped) AS col_attnum
--       FROM pg_class     c
--       JOIN pg_namespace n ON n.oid = c.relnamespace
--      WHERE n.nspname = 'public' AND c.relname = 'wave_invites'
--   ),
--   dep AS (
--     SELECT d.classid, d.objid, d.objsubid,
--            d.refclassid, d.refobjid, d.refobjsubid, d.deptype
--       FROM pg_depend d
--       JOIN alvo ON TRUE
--      WHERE d.refclassid  = 'pg_class'::regclass   -- lado referenciado: RELACAO
--        AND d.refobjid    = alvo.table_oid         -- ... esta tabela
--        AND d.refobjsubid = alvo.col_attnum        -- ... esta coluna
--   ),
--   classificado AS (
--     -- pg_rewrite: views, materialized views e regras
--     SELECT CASE rc.relkind WHEN 'v' THEN 'view' WHEN 'm' THEN 'matview'
--                            ELSE 'regra' END::TEXT AS tipo,
--            rn.nspname::TEXT                       AS esquema,
--            (rw.rulename || ' sobre ' || rc.relname)::TEXT AS nome,
--            'pg_rewrite'::TEXT                     AS classid_nome,
--            dep.*
--       FROM dep
--       JOIN pg_rewrite   rw ON rw.oid = dep.objid
--       JOIN pg_class     rc ON rc.oid = rw.ev_class
--       JOIN pg_namespace rn ON rn.oid = rc.relnamespace
--      WHERE dep.classid = 'pg_rewrite'::regclass
--
--     UNION ALL
--     -- pg_constraint: FOREIGN KEY, CHECK e demais constraints.
--     -- A FK legada EXATA e a unica excluida -- identidade integral.
--     SELECT ('constraint ' || co.contype)::TEXT, cn.nspname::TEXT, co.conname::TEXT,
--            'pg_constraint'::TEXT, dep.*
--       FROM dep
--       JOIN pg_constraint co ON co.oid = dep.objid
--       JOIN pg_class      ct ON ct.oid = co.conrelid
--       JOIN pg_namespace  cn ON cn.oid = ct.relnamespace
--      WHERE dep.classid = 'pg_constraint'::regclass
--        AND NOT (
--              co.conname   = 'wave_responses_invite_token_fkey'
--          AND co.contype   = 'f'
--          AND co.conrelid  = (SELECT table_oid  FROM alvo)
--          AND co.confrelid = (SELECT table_oid  FROM ref_invites)
--          AND array_length(co.conkey,  1) = 1
--          AND co.conkey[1]  = (SELECT col_attnum FROM alvo)
--          AND array_length(co.confkey, 1) = 1
--          AND co.confkey[1] = (SELECT col_attnum FROM ref_invites)
--        )
--
--     UNION ALL
--     -- pg_attrdef: defaults de coluna
--     SELECT 'default de coluna'::TEXT, an.nspname::TEXT,
--            (ac.relname || '.attnum=' || ad.adnum)::TEXT, 'pg_attrdef'::TEXT, dep.*
--       FROM dep
--       JOIN pg_attrdef   ad ON ad.oid = dep.objid
--       JOIN pg_class     ac ON ac.oid = ad.adrelid
--       JOIN pg_namespace an ON an.oid = ac.relnamespace
--      WHERE dep.classid = 'pg_attrdef'::regclass
--
--     UNION ALL
--     -- pg_proc: funcoes com dependencia catalogada sobre a coluna
--     SELECT 'funcao'::TEXT, fn.nspname::TEXT,
--            (pr.proname || '(' || pg_get_function_identity_arguments(pr.oid) || ')')::TEXT,
--            'pg_proc'::TEXT, dep.*
--       FROM dep
--       JOIN pg_proc      pr ON pr.oid = dep.objid
--       JOIN pg_namespace fn ON fn.oid = pr.pronamespace
--      WHERE dep.classid = 'pg_proc'::regclass
--
--     UNION ALL
--     -- pg_trigger: triggers com dependencia catalogada sobre a coluna
--     -- (tipicamente UPDATE OF invite_token). Ver 3.4b para o suplemento textual.
--     SELECT 'trigger'::TEXT, tn.nspname::TEXT,
--            (tg.tgname || ' sobre ' || tt.relname ||
--             CASE WHEN tg.tgisinternal THEN ' [INTERNO]' ELSE '' END)::TEXT,
--            'pg_trigger'::TEXT, dep.*
--       FROM dep
--       JOIN pg_trigger   tg ON tg.oid = dep.objid
--       JOIN pg_class     tt ON tt.oid = tg.tgrelid
--       JOIN pg_namespace tn ON tn.oid = tt.relnamespace
--      WHERE dep.classid = 'pg_trigger'::regclass
--
--     UNION ALL
--     -- pg_policy: SEM excecao. Toda policy dependente da coluna bloqueia,
--     -- inclusive response_submit. Baseline autorizado e zero policies (3.3).
--     SELECT 'policy'::TEXT, sn.nspname::TEXT, pol.polname::TEXT, 'pg_policy'::TEXT, dep.*
--       FROM dep
--       JOIN pg_policy    pol ON pol.oid = dep.objid
--       JOIN pg_class     st  ON st.oid  = pol.polrelid
--       JOIN pg_namespace sn  ON sn.oid  = st.relnamespace
--      WHERE dep.classid = 'pg_policy'::regclass
--
--     UNION ALL
--     -- pg_class: indices, indices de expressao e outras relacoes
--     SELECT CASE ic.relkind WHEN 'i' THEN 'indice' WHEN 'v' THEN 'view'
--                            WHEN 'm' THEN 'matview' WHEN 'r' THEN 'tabela'
--                            ELSE 'relacao ' || ic.relkind END::TEXT,
--            in_.nspname::TEXT, ic.relname::TEXT, 'pg_class'::TEXT, dep.*
--       FROM dep
--       JOIN pg_class     ic  ON ic.oid  = dep.objid
--       JOIN pg_namespace in_ ON in_.oid = ic.relnamespace
--      WHERE dep.classid = 'pg_class'::regclass
--
--     UNION ALL
--     -- QUALQUER outro catalogo: nao reconhecido -> NO-GO antes do primeiro DDL
--     SELECT 'DEPENDENCIA DESCONHECIDA'::TEXT, '?'::TEXT,
--            ('objid=' || dep.objid)::TEXT,
--            coalesce(cc.relname, dep.classid::TEXT)::TEXT, dep.*
--       FROM dep
--       LEFT JOIN pg_class cc ON cc.oid = dep.classid
--      WHERE dep.classid NOT IN ('pg_rewrite'::regclass, 'pg_constraint'::regclass,
--                                'pg_attrdef'::regclass, 'pg_proc'::regclass,
--                                'pg_trigger'::regclass, 'pg_policy'::regclass,
--                                'pg_class'::regclass)
--   )
--   SELECT string_agg(
--            format('[%s] %s.%s (classid=%s objid=%s objsubid=%s deptype=%s '
--                   'refclassid=pg_class refobjid=%s refobjsubid=%s)',
--                   x.tipo, x.esquema, x.nome, x.classid_nome, x.objid, x.objsubid,
--                   x.deptype, x.refobjid, x.refobjsubid),
--            E'\n    ' ORDER BY x.tipo, x.nome)
--     INTO v_deps
--     FROM classificado x;
--
--   IF v_deps IS NOT NULL THEN
--     RAISE EXCEPTION
--       E'ABORTADO: dependencia(s) catalogal(is) sobre wave_responses.invite_token:\n    %\n'
--       'Listado apenas metadado do objeto. NAO remover automaticamente. '
