--
--   -- --- 3.4b TRIGGERS -- suplemento textual (P1-3) ---------------------------
--   -- CORRECAO (revisao 4). A versao anterior listava TODOS os triggers nao
--   -- internos de wave_responses, sem nenhum filtro por invite_token: qualquer
--   -- trigger legitimo (um updated_at, uma auditoria) faria a migration abortar
--   -- SEMPRE, sem relacao alguma com a coluna removida. Falso positivo
--   -- permanente.
--   --
--   -- Agora um trigger so bloqueia com EVIDENCIA de relacao com a coluna:
--   --   1. dependencia catalogada (classid = pg_trigger) -- ja coberta em 3.4,
--   --      e e a fonte PRIMARIA;
--   --   2. este suplemento textual sobre pg_get_triggerdef -- defesa adicional,
--   --      NAO substituta;
--   --   3. inspecao do corpo da FUNCAO chamada pelo trigger -- um trigger cuja
--   --      definicao nao cita a coluna pode acessa-la via NEW.invite_token
--   --      dentro da funcao. Registrado explicitamente e verificado abaixo.
--   -- Nome de parametro NAO conta: \minvite_token\M nao casa p_invite_token.
--   -- Triggers internos (tgisinternal) continuam ignorados -- e so eles.
--   SELECT string_agg(
--            format('%I sobre %I (funcao %s)', tg.tgname, tt.relname,
--                   tg.tgfoid::regprocedure::TEXT), ', ' ORDER BY tg.tgname)
--     INTO v_trigs
--     FROM pg_trigger   tg
