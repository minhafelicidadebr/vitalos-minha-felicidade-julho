--       'ABORTADO (drift operacional): esperadas % respostas no total, encontradas %. '
--       'NAO presumir que as linhas sao seguras. Refazer inventario e solicitar nova autorizacao.',
--       EXPECTED_TOTAL_RESPONSES, v_total_responses;
