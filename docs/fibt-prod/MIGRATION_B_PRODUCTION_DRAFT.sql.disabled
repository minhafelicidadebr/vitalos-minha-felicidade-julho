--   END IF;
--
--   -- --- 3.9 Integridade do conjunto afetado ----------------------------------
--   -- As tres contagens abaixo ja vieram do SELECT unico de 3.5 -- mesmo
--   -- snapshot das outras cinco. Aqui so se avaliam os predicados.
