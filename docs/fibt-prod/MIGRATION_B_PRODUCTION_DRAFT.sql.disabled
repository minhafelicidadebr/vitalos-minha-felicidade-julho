--
--   IF v_trigs IS NOT NULL THEN
--     RAISE EXCEPTION
--       'ABORTADO: trigger(s) com referencia textual a invite_token: %. '
--       'Listado apenas metadado. NAO remover -- solicitar nova revisao.',
--       v_trigs;
--   END IF;
--
--   -- --- 3.5 AS OITO CONTAGENS, EM UM UNICO SELECT, SOB LOCK (P2-2) -----------
--   -- CORRECAO (revisao 4). Antes eram sete statements separados sob READ
--   -- COMMITTED. wave_responses esta protegida por ACCESS EXCLUSIVE, mas
--   -- wave_invites e waves NAO sao bloqueadas (deliberadamente -- ver secao 0,
--   -- inversao de ordem/deadlock). Sob escrita concorrente naquelas duas,
--   -- statements distintos poderiam observar snapshots distintos e disparar uma
--   -- invariante ESPURIA. Um unico SELECT: um unico snapshot de statement.
--   --
--   -- NAO se adota REPEATABLE READ: desnecessario, e mudaria a semantica de
--   -- isolamento de todo o bloco por um problema que o snapshot unico resolve.
--   --
--   -- v_snapshot_rows permanece uma coluna PROPRIA, com definicao propria
--   -- (linhas cujo vinculo se perde no DROP). Como agora as duas expressoes sao
--   -- avaliadas no MESMO statement, a invariante v_snapshot_rows =
--   -- v_with_invite_token passa a ser DEFINICIONAL, nao um detector de
--   -- concorrencia -- registrado sem eufemismo.
--   SELECT
--     (SELECT COUNT(*) FROM public.wave_responses),
--     (SELECT COUNT(*) FROM public.wave_responses WHERE invite_token IS NOT NULL),
--     (SELECT COUNT(*) FROM public.wave_responses r
--       WHERE r.invite_token IS NOT NULL
--         AND EXISTS (SELECT 1 FROM public.wave_invites i WHERE i.token = r.invite_token)),
--     (SELECT COUNT(*) FROM public.wave_responses r
--       WHERE r.invite_token IS NOT NULL
--         AND NOT EXISTS (SELECT 1 FROM public.wave_invites i WHERE i.token = r.invite_token)),
--     (SELECT COUNT(*) FROM public.wave_responses WHERE invite_token IS NOT NULL),
--     (SELECT COUNT(*) FROM (
--        SELECT invite_token FROM public.wave_responses
--         WHERE invite_token IS NOT NULL GROUP BY invite_token HAVING COUNT(*) > 1) d),
--     (SELECT COUNT(*) FROM public.wave_responses r
--        JOIN public.wave_invites i ON i.token = r.invite_token
--       WHERE r.invite_token IS NOT NULL AND r.wave_id <> i.wave_id),
--     (SELECT COUNT(*) FROM public.wave_responses r
--        LEFT JOIN public.waves w ON w.id = r.wave_id
--       WHERE r.invite_token IS NOT NULL AND (w.id IS NULL OR w.org_id IS NULL))
--   INTO
--     v_total_responses, v_with_invite_token, v_valid_invite_links,
--     v_orphan_invite_links, v_snapshot_rows,
--     v_duplicados, v_divergentes, v_org_invalida;
